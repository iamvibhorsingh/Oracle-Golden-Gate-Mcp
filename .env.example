# GoldenGate MCP Server Configuration
# Copy this file to .env and update with your values

# ============================================================================
# Security Settings
# ============================================================================

# Run in read-only mode (recommended for safety)
# Set to false only if you need write operations (start/stop processes)
GG_READ_ONLY=true

# Enable background metrics collection and SQLite storage (default: false)
# Leave false for a lightweight, pure REST pass-through mode with no local
# disk usage. Set true to enable: diagnose_lag_issue, get_performance_baseline,
# get_lag_trend.
GG_ENABLE_METRICS=false

# ============================================================================
# GoldenGate Deployments
# ============================================================================

# Deployment 1 - Production
GG_DEPLOYMENT_1_NAME=gg21_prod
GG_DEPLOYMENT_1_URL=https://gg-prod-host:9100
GG_DEPLOYMENT_1_USERNAME=oggadmin
GG_DEPLOYMENT_1_PASSWORD=your_secure_password_here
GG_DEPLOYMENT_1_VERIFY_SSL=true

# Deployment 2 - Test Environment
GG_DEPLOYMENT_2_NAME=gg23_test
GG_DEPLOYMENT_2_URL=https://gg-test-host:9100
GG_DEPLOYMENT_2_USERNAME=oggadmin
GG_DEPLOYMENT_2_PASSWORD=your_secure_password_here
GG_DEPLOYMENT_2_VERIFY_SSL=false

# Add more deployments as needed (increment the number)
# GG_DEPLOYMENT_3_NAME=...
# GG_DEPLOYMENT_3_URL=...
# etc.

# ============================================================================
# Server Settings
# ============================================================================

# Request timeout in seconds
GG_REQUEST_TIMEOUT=30

# Audit log path (relative to project root or absolute path)
GG_AUDIT_LOG_PATH=./logs/audit.log

# Performance Settings (Infrastructure Protection)
# These settings protect your GoldenGate servers from being overwhelmed
# NOT for cost optimization - Azure Copilot Enterprise has different pricing

# Cache TTL in seconds (reduces repeated API calls)
# Default: 30 seconds (good balance between freshness and load reduction)
GG_CACHE_TTL_SECONDS=30

# Maximum concurrent requests to GoldenGate API
# Default: 10 (prevents overwhelming your GoldenGate server)
# Increase if you have powerful infrastructure, decrease if you see issues
GG_MAX_CONCURRENT_REQUESTS=10

# Maximum requests per second to GoldenGate API
# Default: 20 (prevents rate limiting or server overload)
# Adjust based on your GoldenGate server capacity
GG_REQUESTS_PER_SECOND=20

# ============================================================================
# Phase 1 Intelligence - Database Monitoring (Optional)
# ============================================================================

# Database monitoring enables correlation between database performance
# and GoldenGate replication lag. This is optional but recommended.

# To enable database monitoring:
# 1. Install oracledb: pip install -e ".[database]"
# 2. Configure database connections below

# Source Database 1
GG_DB_MONITOR_1_NAME=prod_source
GG_DB_MONITOR_1_TYPE=oracle
GG_DB_MONITOR_1_DSN=source-host:1521/PRODDB
GG_DB_MONITOR_1_USERNAME=gg_monitor
GG_DB_MONITOR_1_PASSWORD=monitor_password

# Target Database 1
GG_DB_MONITOR_2_NAME=prod_target
GG_DB_MONITOR_2_TYPE=oracle
GG_DB_MONITOR_2_DSN=target-host:1521/TARGETDB
GG_DB_MONITOR_2_USERNAME=gg_monitor
GG_DB_MONITOR_2_PASSWORD=monitor_password

# Add more database connections as needed
# GG_DB_MONITOR_3_NAME=...
# etc.

# ============================================================================
# Notes
# ============================================================================

# SSL Verification:
# - Set VERIFY_SSL=true in production (recommended)
# - Set VERIFY_SSL=false only for testing with self-signed certificates

# Credentials:
# - Never commit this file with real credentials
# - Use strong passwords
# - Consider using a secrets manager in production

# Database Monitoring:
# - Requires SELECT privileges on v$sysmetric, v$database, v$session
# - Optional but provides valuable correlation data
# - Can be disabled by not setting GG_DB_MONITOR_* variables

# Audit Logging:
# - All operations are logged to the audit log
# - Review logs regularly for security monitoring
# - Logs include timestamps, actions, and results
